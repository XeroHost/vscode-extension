{
  "name": "xerohost",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.3.0",
  "publisher": "xerohost",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/XeroHost/vscode-extension.git"
  },
  "homepage": "https://github.com/XeroHost/vscode-extension#readme",
  "bugs": {
    "url": "https://github.com/XeroHost/vscode-extension/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "activationEvents": [
    "onFileSystem:xerohost",
    "onUri"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "xerohost.signIn",
        "title": "%command.signIn%",
        "category": "XeroHost"
      },
      {
        "command": "xerohost.signOut",
        "title": "%command.signOut%",
        "category": "XeroHost"
      },
      {
        "command": "xerohost.openServer",
        "title": "%command.openServer%",
        "category": "XeroHost"
      },
      {
        "command": "xerohost.openConsole",
        "title": "%command.openConsole%",
        "category": "XeroHost"
      },
      {
        "command": "xerohost.powerAction",
        "title": "%command.powerAction%",
        "category": "XeroHost"
      },
      {
        "command": "xerohost.files.compress",
        "title": "%command.compress%",
        "category": "XeroHost"
      },
      {
        "command": "xerohost.files.decompress",
        "title": "%command.decompress%",
        "category": "XeroHost"
      },
      {
        "command": "xerohost.refresh",
        "title": "%command.refresh%",
        "category": "XeroHost",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "xerohost.files.compress",
          "when": "false"
        },
        {
          "command": "xerohost.files.decompress",
          "when": "false"
        },
        {
          "command": "xerohost.refresh",
          "when": "xerohost.hasMountedServer"
        }
      ],
      "explorer/context": [
        {
          "command": "xerohost.files.compress",
          "when": "resourceScheme == xerohost",
          "group": "xerohost@1"
        },
        {
          "command": "xerohost.files.decompress",
          "when": "resourceScheme == xerohost && resourceFilename =~ /\\.(zip|tar|tar\\.(gz|xz|bz2)|tgz|rar)$/",
          "group": "xerohost@2"
        },
        {
          "command": "xerohost.refresh",
          "when": "resourceScheme == xerohost && explorerResourceIsFolder",
          "group": "xerohost@3"
        }
      ],
      "view/title": [
        {
          "command": "xerohost.refresh",
          "when": "view == workbench.explorer.fileView && xerohost.hasMountedServer",
          "group": "navigation@50"
        }
      ]
    },
    "configuration": {
      "title": "XeroHost",
      "properties": {
        "xerohost.console.prompt": {
          "type": "string",
          "default": "container@xerohost~",
          "description": "%config.console.prompt%"
        },
        "xerohost.files.downloadThresholdMiB": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 64,
          "description": "%config.files.downloadThresholdMiB%"
        },
        "xerohost.files.pollIntervalSeconds": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "maximum": 600,
          "markdownDescription": "%config.files.pollIntervalSeconds%"
        }
      }
    },
    "terminal": {
      "profiles": [
        {
          "id": "xerohost.console",
          "title": "%terminal.profile.title%",
          "icon": "server-environment"
        }
      ]
    }
  },
  "scripts": {
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "npm run typecheck && npm run check:l10n && node esbuild.mjs --production",
    "package": "vsce package --no-dependencies",
    "test:live": "node test/build.mjs && node test/live.mjs",
    "check:l10n": "node scripts/check-l10n.mjs"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/vscode": "1.90.0",
    "@types/ws": "^8.5.12",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  },
  "l10n": "./l10n"
}
