{
  "name": "xerohost",
  "displayName": "XeroHost",
  "description": "Edit your XeroHost game server files and use its console and power controls from VS Code. Edita los archivos de tu servidor XeroHost y usa su consola desde VS Code.",
  "version": "0.1.0",
  "publisher": "xerohost",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/XeroHost"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "activationEvents": [
    "onFileSystem:xerohost",
    "onUri"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "xerohost.signIn",
        "title": "Sign In",
        "category": "XeroHost"
      },
      {
        "command": "xerohost.signOut",
        "title": "Sign Out",
        "category": "XeroHost"
      },
      {
        "command": "xerohost.openServer",
        "title": "Open Server Files",
        "category": "XeroHost"
      },
      {
        "command": "xerohost.openConsole",
        "title": "Open Server Console",
        "category": "XeroHost"
      },
      {
        "command": "xerohost.powerAction",
        "title": "Server Power Action",
        "category": "XeroHost"
      },
      {
        "command": "xerohost.files.compress",
        "title": "Compress",
        "category": "XeroHost"
      },
      {
        "command": "xerohost.files.decompress",
        "title": "Extract Archive Here",
        "category": "XeroHost"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "xerohost.files.compress",
          "when": "false"
        },
        {
          "command": "xerohost.files.decompress",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "xerohost.files.compress",
          "when": "resourceScheme == xerohost",
          "group": "xerohost@1"
        },
        {
          "command": "xerohost.files.decompress",
          "when": "resourceScheme == xerohost && resourceFilename =~ /\\.(zip|tar|tar\\.(gz|xz|bz2)|tgz|rar)$/",
          "group": "xerohost@2"
        }
      ]
    },
    "configuration": {
      "title": "XeroHost",
      "properties": {
        "xerohost.console.prompt": {
          "type": "string",
          "default": "container@xerohost~",
          "description": "Prompt shown in front of console messages and replacing the panel's default prompt."
        },
        "xerohost.files.downloadThresholdMiB": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 64,
          "description": "Files larger than this are opened through a signed download link instead of the panel's file contents endpoint."
        }
      }
    },
    "terminal": {
      "profiles": [
        {
          "id": "xerohost.console",
          "title": "XeroHost Console",
          "icon": "server-environment"
        }
      ]
    }
  },
  "scripts": {
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "npm run typecheck && node esbuild.mjs --production",
    "package": "vsce package --no-dependencies",
    "test:live": "node test/build.mjs && node test/live.mjs"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/vscode": "1.90.0",
    "@types/ws": "^8.5.12",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
